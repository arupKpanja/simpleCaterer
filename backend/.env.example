# Caterer System — Part 1 configuration (copy to .env to override defaults).
# All settings are optional; the defaults run fully locally with zero setup.

# --- Database ---------------------------------------------------------------
# SQLite by default (single file). Point at Postgres to switch with no code
# changes, e.g. postgresql+psycopg://user:pass@localhost:5432/caterer
# CATERER_DATABASE_URL=sqlite:///caterer.db

# --- LLM inference (Ollama) -------------------------------------------------
# CATERER_OLLAMA_BASE_URL=http://localhost:11434
# CATERER_OLLAMA_MODEL=llama3.1:8b
# CATERER_LLM_TIMEOUT_SECONDS=60
# Force the deterministic rule-based planner even if Ollama is reachable:
# CATERER_FORCE_FALLBACK_LLM=false

# --- Planning ---------------------------------------------------------------
# CATERER_DEFAULT_COURSES=4

# --- Logging ----------------------------------------------------------------
# CATERER_LOG_LEVEL=INFO
# CATERER_LOG_JSON=false        # true = single-line JSON logs for aggregation
